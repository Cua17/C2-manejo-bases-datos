<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.1.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#FPArithmetic" name="4"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#TTL" name="7"/>
  <lib desc="#TCL" name="8"/>
  <lib desc="#Base" name="9"/>
  <lib desc="#BFH-Praktika" name="10"/>
  <lib desc="#Input/Output-Extra" name="11"/>
  <lib desc="#Soc" name="12"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <circuit name="sumador1bit">
    <a name="circuit" val="sumador1bit"/>

    <comp lib="0" loc="(100,80)" name="Pin"><a name="label" val="A"/></comp>
    <comp lib="0" loc="(100,160)" name="Pin"><a name="label" val="B"/></comp>
    <comp lib="0" loc="(100,380)" name="Pin"><a name="label" val="Cin"/></comp>
    <comp lib="0" loc="(460,120)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="S"/></comp>
    <comp lib="0" loc="(460,260)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="Cout"/></comp>

    <comp lib="1" loc="(200,120)" name="XOR Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(200,220)" name="AND Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(340,180)" name="XOR Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(340,320)" name="AND Gate"><a name="size" val="30"/></comp>
    <comp lib="1" loc="(430,260)" name="OR Gate"><a name="size" val="30"/></comp>

    <wire from="(100,80)" to="(120,80)"/>
    <wire from="(120,80)" to="(120,210)"/>
    <wire from="(120,110)" to="(170,110)"/>
    <wire from="(120,210)" to="(170,210)"/>

    <wire from="(100,160)" to="(140,160)"/>
    <wire from="(140,130)" to="(140,230)"/>
    <wire from="(140,130)" to="(170,130)"/>
    <wire from="(140,230)" to="(170,230)"/>

    <wire from="(200,120)" to="(240,120)"/>
    <wire from="(240,120)" to="(240,170)"/>
    <wire from="(240,170)" to="(310,170)"/>
    <wire from="(240,310)" to="(310,310)"/>
    <wire from="(240,170)" to="(240,310)"/>

    <wire from="(100,380)" to="(260,380)"/>
    <wire from="(260,190)" to="(260,380)"/>
    <wire from="(260,190)" to="(310,190)"/>
    <wire from="(260,330)" to="(310,330)"/>
    <wire from="(260,190)" to="(260,330)"/>

    <wire from="(200,220)" to="(280,220)"/>
    <wire from="(280,220)" to="(280,250)"/>
    <wire from="(280,250)" to="(400,250)"/>

    <wire from="(340,320)" to="(370,320)"/>
    <wire from="(370,320)" to="(370,270)"/>
    <wire from="(370,270)" to="(400,270)"/>

    <wire from="(340,180)" to="(400,180)"/>
    <wire from="(400,180)" to="(400,120)"/>
    <wire from="(400,120)" to="(460,120)"/>

    <wire from="(430,260)" to="(460,260)"/>
  </circuit>

  <circuit name="main">
    <a name="circuit" val="main"/>
    <comp lib="0" loc="(200,150)" name="Pin"><a name="label" val="A0"/></comp>
    <comp lib="0" loc="(200,160)" name="Pin"><a name="label" val="B0"/></comp>
    <comp lib="0" loc="(200,170)" name="Pin"><a name="label" val="Cin"/></comp>
    <comp lib="0" loc="(200,350)" name="Pin"><a name="label" val="A1"/></comp>
    <comp lib="0" loc="(200,360)" name="Pin"><a name="label" val="B1"/></comp>

    <comp lib="0" loc="(360,150)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="S0"/></comp>
    <comp lib="0" loc="(360,350)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="S1"/></comp>
    <comp lib="0" loc="(360,360)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/><a name="label" val="Cout"/></comp>

    <comp loc="(300,150)" name="sumador1bit"/>
    <comp loc="(300,350)" name="sumador1bit"/>

    <wire from="(200,150)" to="(270,150)"/>
    <wire from="(200,160)" to="(270,160)"/>
    <wire from="(200,170)" to="(270,170)"/>
    <wire from="(300,150)" to="(360,150)"/>

    <wire from="(200,350)" to="(270,350)"/>
    <wire from="(200,360)" to="(270,360)"/>
    <wire from="(300,350)" to="(360,350)"/>
    <wire from="(300,360)" to="(360,360)"/>

    <wire from="(300,160)" to="(300,340)"/>
    <wire from="(300,340)" to="(250,340)"/>
    <wire from="(250,340)" to="(250,370)"/>
    <wire from="(250,370)" to="(270,370)"/>
  </circuit>
</project>
